{
  "manifest_version": 3,
  "name": "PaperTrail — Job Application Tracker",
  "short_name": "PaperTrail",
  "version": "0.1.0",
  "description": "Logs your job applications on any job site the moment you apply, and keeps a copy of the posting after it disappears.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PaperTrail",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "dashboard/dashboard.html",
  "permissions": ["storage", "contextMenus", "alarms", "activeTab", "scripting"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/card-css.js", "content/extract.js", "content/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
